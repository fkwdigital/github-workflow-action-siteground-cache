    "deployment"
  ],
  "dependencies": {},
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "eslint": "^7.27.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.23.3"
  },
  "scripts": {
